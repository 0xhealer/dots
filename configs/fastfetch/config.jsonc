{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // No ASCII art - keeps output compact, closer to the reference screenshot.
    "logo": {
        "type": "none"
    },

    "modules": [
        {
            "type": "custom",
            "format": "{#212}—{#}"
        },
        {
            "type": "title",
            "key": "🩸", // stand-in for a distro icon
            "keyColor": "212",
            "format": "{host-name}",
            "outputColor": "1;97"
        },
        {
            "type": "kernel",
            "key": " ",
            "format": "{release}",
            "outputColor": "97"
        },
        {
            "type": "wm",
            "format": "{pretty-name}"
        },
        {
            "type": "shell",
            "key": " ",
            "format": "{exe-name} {version}",
            "outputColor": "213"
        },
        {
            "type": "custom",
            "format": "{#212}—{#}"
        }
    ]
}
