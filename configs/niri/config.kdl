// Niri config -- CachyOS box. KDL format: https://kdl.dev
// Bar/launcher/lock/session are Noctalia (primary), Vicinae is a
// secondary launcher added back per request -- no Waybar.
// Keybinds mirror KEYBINDS.md -- update that table first, then this file.
// Action names verified against niri-wm/niri's own default-config.kdl.
//
// TEMPORARY: this file has a VM-testing-only foot terminal bind
// (Mod+Shift+Return). Search "TEMPORARY" in this file and remove that
// bind, plus "foot" from packages/pacman.txt, once off the VM.

input {
    keyboard {
        xkb {
        }
    }
    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 8
    focus-ring {
        width 2
    }
}

// Blur -- niri 26.04 (April 2026) added blur via the ext-background-effect
// protocol. Noctalia, Vicinae, Foot, Kitty, Ghostty, and Quickshell all
// get it with NO config needed here at all, per niri's own release notes
// -- that covers everything in this setup, nothing further to add.

// NOTE: "qs" "-c" "noctalia-shell" is the v4 (Quickshell) launch command.
// Confirmed v4 from a running install (noctalia-shell-4.7.7).
//
// "vicinae" "server" MUST be running before "vicinae" "toggle" does
// anything -- confirmed from Vicinae's own docs (docs.vicinae.com). This
// is the actual reason the launcher wasn't opening: the bind called a
// bare "vicinae" with no server running and no toggle arg.
spawn-at-startup "qs" "-c" "noctalia-shell"
spawn-sh-at-startup "wl-paste --watch cliphist store"
spawn-at-startup "vicinae" "server"

// Niri's built-in hotkey overlay (Mod+Shift+Slash) lists every bind
// below along with its hotkey-overlay-title -- this IS the "keybindings
// with app name" cheatsheet, no custom file needed on this leg. Every
// bind below has a title now so the overlay is actually useful.
hotkey-overlay {
    skip-at-startup
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+T hotkey-overlay-title="Terminal (kitty)" { spawn "kitty"; }
    Mod+Return hotkey-overlay-title="Terminal (kitty)" { spawn "kitty"; }
    // TEMPORARY -- VM testing only, remove this bind (and foot from
    // packages/pacman.txt) once off the VM. kitty can fail to launch or
    // render under VMware's SVGA virtual GPU; foot works with much less
    // GPU capability.
    Mod+Shift+Return hotkey-overlay-title="Terminal (foot, VM testing only)" { spawn "foot"; }

    Mod+D hotkey-overlay-title="Noctalia launcher" { spawn "qs" "-c" "noctalia-shell" "--launcher"; }
    Mod+Space hotkey-overlay-title="Noctalia launcher" { spawn "qs" "-c" "noctalia-shell" "--launcher"; }
    // Fixed: "vicinae" "toggle", not bare "vicinae" -- see the
    // spawn-at-startup note above.
    Mod+Shift+D hotkey-overlay-title="Vicinae (secondary launcher)" { spawn "vicinae" "toggle"; }
    Mod+M hotkey-overlay-title="Spotify" { spawn "spotify"; }
    Mod+E hotkey-overlay-title="File manager (Thunar)" { spawn "thunar"; }
    Mod+B hotkey-overlay-title="Browser (Zen)" { spawn "zen-browser"; }

    // niri's own default binds Mod+F to maximize-column and
    // Mod+Shift+F to fullscreen-window. This overrides Mod+F to match
    // the Hyprland leg's binding in KEYBINDS.md.
    Mod+F hotkey-overlay-title="Fullscreen toggle" { fullscreen-window; }

    Mod+Q hotkey-overlay-title="Close window" { close-window; }
    Mod+Tab hotkey-overlay-title="Noctalia lock screen" { spawn "qs" "-c" "noctalia-shell" "--lock"; }

    // UNVERIFIED: could not confirm the session/logout-panel CLI flag
    // for Noctalia v4 -- check `qs -c noctalia-shell --help` first
    Mod+Escape allow-inhibiting=false hotkey-overlay-title="Noctalia control center" { spawn "qs" "-c" "noctalia-shell" "--control-center"; }

    Mod+V hotkey-overlay-title="Toggle floating" { toggle-window-floating; }

    Print hotkey-overlay-title="Screenshot" { screenshot; }
    Alt+Print hotkey-overlay-title="Screenshot (window)" { screenshot-window; }

    // Workspaces -- kept parallel to the Hyprland leg's 1-4
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }

    Mod+Shift+E hotkey-overlay-title="Quit niri" { quit; }
}
