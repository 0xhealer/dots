// Niri config. KDL format: https://kdl.dev
// Launcher is Rofi. Noctalia (bar/lock) is optional and only started if
// installed. Keybinds mirror assets/keybindings.txt.
//
// Colours are NOT set here: they come from the wallpaper-driven palette
// (~/.config/theme/theme.conf, rendered by theme-apply). niri >= 25.11 reads
// it through `include`; older niri gets the same file spliced in by
// functions/08-niri.sh / theme-apply.
include "../theme/generated/niri.kdl"

input {
    keyboard {
        xkb {
        }
    }
    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 8
    focus-ring {
        width 2
    }
}

// Kitty opacity, explicit for both focus states -- confirmed real
// syntax from niri's own docs (window-rule + match is-active=true/false
// + opacity), cross-checked across 5 independent sources.
//
// The "goes opaque when I select it" symptom is a CONFIRMED REAL niri
// bug (niri-wm/niri#1823, "Focus ring color spills over to app window
// when opacity is set to less than 1"), not a config mistake -- the
// report describes kitty turning opaque with the focus-ring color as
// its background specifically while focused, and calls out kitty by
// name as affected while some other terminals aren't. My earlier
// 0.88/0.75 values were never going to fix this; the bug happens
// regardless of which opacity value you pick. The actual workaround is
// disabling the focus ring for kitty specifically, since that's the
// thing bleeding through.
window-rule {
    match app-id="^(kitty|com.mitchellh.ghostty|foot)$" is-active=true
    opacity 0.88
    focus-ring {
        off
    }
}
window-rule {
    match app-id="^(kitty|com.mitchellh.ghostty|foot)$" is-active=false
    opacity 0.75
}

// Blur -- niri 26.04 (April 2026) added blur via the ext-background-effect
// protocol. Noctalia, Vicinae, Foot, Kitty, Ghostty, and Quickshell all
// get it with NO config needed here at all, per niri's own release notes
// -- that covers everything in this setup, nothing further to add. Now
// doubly confirmed: Noctalia's own v5 FAQ says niri "publishes blur
// regions even for transparent bars" automatically, and covers how to
// DISABLE it if unwanted -- confirming it's on by default, matching
// what's documented here.
//
// The actual missing piece for visible blur wasn't compositor config on
// either leg -- it was Noctalia's own backgroundOpacity defaulting to 1
// (fully opaque), confirmed and fixed for v4. Upgrading to v5 now --
// its opacity/blur equivalents aren't guessed here, see
// configs/noctalia/config.toml's comments.

// Everything is guarded so a missing optional program can't break the session.
spawn-sh-at-startup "$HOME/.config/theme/theme-apply --restore"
spawn-sh-at-startup "command -v noctalia >/dev/null && exec noctalia --daemon"
spawn-sh-at-startup "wl-paste --watch cliphist store"
spawn-sh-at-startup "command -v vicinae >/dev/null && exec vicinae server"
// niri has no built-in Xwayland; this makes X11-only apps work if installed.
spawn-sh-at-startup "command -v xwayland-satellite >/dev/null && exec xwayland-satellite"

// Niri's built-in hotkey overlay (Mod+Shift+Slash) lists every bind
// below along with its hotkey-overlay-title -- this IS the "keybindings
// with app name" cheatsheet, no custom file needed on this leg. Every
// bind below has a title now so the overlay is actually useful.
hotkey-overlay {
    skip-at-startup
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+T hotkey-overlay-title="Terminal (kitty > ghostty > foot)" { spawn-sh "$HOME/.local/bin/dots-term"; }
    Mod+Return hotkey-overlay-title="Terminal" { spawn-sh "$HOME/.local/bin/dots-term"; }
    Mod+Shift+Return hotkey-overlay-title="Terminal (ghostty)" { spawn "ghostty"; }
    Mod+Ctrl+Return hotkey-overlay-title="Terminal (foot)" { spawn "foot"; }

    Mod+D hotkey-overlay-title="Rofi launcher" { spawn "rofi" "-show" "drun"; }
    Mod+Space hotkey-overlay-title="Rofi launcher" { spawn "rofi" "-show" "drun"; }
    Mod+Shift+D hotkey-overlay-title="Rofi run" { spawn "rofi" "-show" "run"; }
    Mod+Shift+Space hotkey-overlay-title="Rofi window switcher" { spawn "rofi" "-show" "window"; }
    Mod+W hotkey-overlay-title="Pick wallpaper + re-theme" { spawn-sh "$HOME/.config/theme/theme-apply --pick"; }
    Mod+Shift+W hotkey-overlay-title="Random wallpaper + re-theme" { spawn-sh "$HOME/.config/theme/theme-apply --random"; }
    Mod+M hotkey-overlay-title="Spotify" { spawn "spotify"; }
    Mod+E hotkey-overlay-title="File manager (Thunar)" { spawn "thunar"; }
    Mod+B hotkey-overlay-title="Browser" { spawn-sh "$HOME/.local/bin/dots-browser"; }

    // niri's own default binds Mod+F to maximize-column and
    // Mod+Shift+F to fullscreen-window. This overrides Mod+F to match
    // historical parity with a since-removed Hyprland leg -- kept for consistency.
    Mod+F hotkey-overlay-title="Fullscreen toggle" { fullscreen-window; }

    Mod+Q hotkey-overlay-title="Close window" { close-window; }
    Mod+Tab hotkey-overlay-title="Noctalia lock screen" { spawn-sh "command -v noctalia >/dev/null && noctalia msg session lock"; }

    // v5: confirmed IPC command (cross-referenced from official docs AND
    // a real working niri config in a first-hand blog post), replaces
    // the old v4 --control-center flag, which was itself an UNVERIFIED
    // placeholder that never got confirmed.
    Mod+Escape allow-inhibiting=false hotkey-overlay-title="Noctalia control center" { spawn-sh "command -v noctalia >/dev/null && noctalia msg panel-toggle control-center"; }

    Mod+V hotkey-overlay-title="Toggle floating" { toggle-window-floating; }

    Print hotkey-overlay-title="Screenshot" { screenshot; }
    Alt+Print hotkey-overlay-title="Screenshot (window)" { screenshot-window; }

    // Workspaces 1-4
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }

    Mod+Shift+E hotkey-overlay-title="Quit niri" { quit; }
}
