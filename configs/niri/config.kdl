// Niri config -- CachyOS box. KDL format: https://kdl.dev
// Bar/launcher/lock/session are Noctalia (primary), Vicinae is a
// secondary launcher added back per request -- no Waybar.
// Keybinds mirror KEYBINDS.md -- update that table first, then this file.
// Action names verified against niri-wm/niri's own default-config.kdl.
//
// TEMPORARY: this file has a VM-testing-only foot terminal bind
// (Mod+Shift+Return). Search "TEMPORARY" in this file and remove that
// bind, plus "foot" from packages/pacman.txt, once off the VM.

input {
    keyboard {
        xkb {
        }
    }
    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 8
    focus-ring {
        width 2
    }
}

// Blur -- niri 26.04 (April 2026) added blur via the ext-background-effect
// protocol. Apps/shells that support it natively (Noctalia, Vicinae, Foot,
// Kitty, Ghostty, Quickshell per niri's own release notes) get it with NO
// config needed here at all. For anything else, niri exposes manual blur
// via window-rule/layer-rule blocks -- but I could not find a confirmed
// KDL key name for it (this feature is ~4 months old at time of writing
// and the wiki examples I found didn't show the exact syntax). The block
// below is commented out because I will not ship a guessed key in a config
// you're about to run -- check https://github.com/YaLTeR/niri/wiki (or
// `niri msg` help) for the real key, likely something like `blur` inside
// window-rule / layer-rule, then uncomment and fix:
//
// window-rule {
//     match app-id=".*"
//     // blur true  <- confirm real key name before uncommenting
// }

// NOTE: "qs" "-c" "noctalia-shell" is the v4 (Quickshell) launch command.
// Noctalia v5 dropped Quickshell/Qt -- if the AUR package is v5 this is
// wrong. Check `noctalia-shell --version` before trusting this.
spawn-at-startup "qs" "-c" "noctalia-shell"
spawn-sh-at-startup "wl-paste --watch cliphist store"

hotkey-overlay {
    skip-at-startup
}

binds {
    Mod+T { spawn "kitty"; }
    Mod+Return { spawn "kitty"; }
    // TEMPORARY -- VM testing only, remove this bind (and foot from
    // packages/pacman.txt) once off the VM. kitty can fail to launch or
    // render under VMware's SVGA virtual GPU; foot works with much less
    // GPU capability.
    Mod+Shift+Return { spawn "foot"; }

    Mod+D hotkey-overlay-title="Noctalia launcher" { spawn "qs" "-c" "noctalia-shell" "--launcher"; }
    Mod+Space hotkey-overlay-title="Noctalia launcher" { spawn "qs" "-c" "noctalia-shell" "--launcher"; }
    // Vicinae as a secondary launcher (Noctalia's is primary on Mod+D) --
    // installed via packages/aur.txt but this invocation is a guess, not
    // confirmed against Vicinae's actual CLI/usage docs.
    Mod+Shift+D { spawn "vicinae"; }
    Mod+M { spawn "spotify"; }
    Mod+E { spawn "thunar"; }
    Mod+B { spawn "zen-browser"; }

    // niri's own default binds Mod+F to maximize-column and
    // Mod+Shift+F to fullscreen-window. This overrides Mod+F to match
    // the Hyprland leg's binding in KEYBINDS.md.
    Mod+F { fullscreen-window; }

    Mod+Q { close-window; }
    Mod+Tab { spawn "qs" "-c" "noctalia-shell" "--lock"; }

    // UNVERIFIED: could not confirm the session/logout-panel CLI flag
    // for Noctalia v4 -- check `qs -c noctalia-shell --help` first
    Mod+Escape allow-inhibiting=false { spawn "qs" "-c" "noctalia-shell" "--control-center"; }

    Mod+V { toggle-window-floating; }

    Print { screenshot; }
    Alt+Print { screenshot-window; }

    // Workspaces -- kept parallel to the Hyprland leg's 1-4
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }

    Mod+Shift+E { quit; }
}
