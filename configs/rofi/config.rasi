// Rofi config -- CachyOS box, third launcher (Mod+Shift+Space).
// Colors come from Noctalia's matugen-compatible wallpaper theming via
// functions/14-matugen-templates.sh -- NOT a static palette, changes
// with the wallpaper same as kitty/gtk/qt do.
//
// Import path is the output_path of [theme.templates.user.rofi] in
// configs/noctalia/config.toml (the file that is actually deployed).
// This used to point at ~/.config/noctalia/templates/colors/rofi.rasi
// (the old, undeployed user-templates.toml), which Noctalia never wrote
// to. functions/14-matugen-templates.sh seeds a placeholder so the import
// resolves before Noctalia's first run.
@import "~/.config/rofi/colors.rasi"

configuration {
    modi: "drun,run,window";
    show-icons: true;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    width: 30%;
    border: 2px;
    border-radius: 8px;
}
